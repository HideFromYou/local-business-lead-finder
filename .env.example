# Copy to .env and fill in. Never commit .env.

# Contact info sent in the Overpass User-Agent (OSM asks for a way to reach you)
OVERPASS_CONTACT=you@example.com
OVERPASS_URL=https://overpass-api.de/api/interpreter

# SQLite database file
DB_PATH=site_finder.db

# Phase 5 (optional)
GOOGLE_PLACES_API_KEY=

# Connect to Google/OSM over IPv4 only (default). Some home networks cannot reach Google over IPv6 and searches hang.
# Set to 0 only if your network is IPv6-only.
FORCE_IPV4=1
